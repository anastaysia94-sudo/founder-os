{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "smartpickshop-four-offer",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-26",
  "assets": {
    "directory": "../public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [{ "binding": "DB" }]
}
