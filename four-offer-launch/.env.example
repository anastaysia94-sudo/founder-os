# Four Offer Launch deployment template
# Copy variable names into the deployment platform's secret store.
# Never commit real credentials.

# Public storefront
PUBLIC_BASE_URL=https://your-storefront.example
PORT=3000

# PayPal Orders API
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Private Supabase server access
SUPABASE_SECRET_KEY=
DELIVERY_TOKEN_SECRET=

# Optional hosted commercial checkout-link fallback.
# Leave blank when using the recommended Orders API flow.
PAYPAL_CASHH_STARTER=
PAYPAL_CASHH_EXPANDED=
PAYPAL_REMOTE_CAREER_DIY=
PAYPAL_AI_HANDOFF=
PAYPAL_LNC_EXPANDED=
